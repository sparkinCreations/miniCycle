# OS files
.DS_Store
Thumbs.db

# Private developer docs
web/docs/DEVELOPER_PROFILE.md

# Local-only archive and presentation decks (kept on disk, not in the repo).
# web/archive/ is anchored so it does NOT match web/docs/archive/, which stays tracked.
web/archive/
*.pptx

# Dependencies
web/blog/node_modules/

# Test output (regenerated every run)
web/test-results/

# Claude Code session files
web/.claude/

# Chrome extension build artifacts (regenerated by update-version.sh --chrome)
chrome/full-*.zip

# Python bytecode cache. update-version.sh runs scripts/validate-csp.py on every
# release, so without this the regenerated .pyc gets swept into each release
# commit by `git add -A` (happened in v2.318).
__pycache__/
*.pyc

# macOS/Finder "name 2.ext" duplicate copies — never commit them
* 2.*

# Scratch output from Claude Code skills/plugins that write into the repo ROOT
# rather than a scratchpad: the xlsx skill drops outputs/<uuid>/, the pdf-viewer
# plugin drops tmp/pdfs/, spreadsheet builds drop tmp/spreadsheets/. None of it
# belongs to miniCycle — it is whatever else was being worked on in this folder.
#
# Ignored for the same reason as __pycache__/ above: update-version.sh stages the
# release with `git add -A`, so anything untracked at the root rides into the
# release commit and gets pushed public. Measured Oct 8 2026: 1.5 MB of unrelated
# op-amp lab PNGs and a comparator spreadsheet were sitting here, one release away
# from being committed.
outputs/
tmp/
