{
  "manifest_version": 3,
  "name": "miniCycle lite",
  "version": "1.2",
  "version_name": "Chrome Edition v1.2",
  "description": "A quick, reusable checklist for your repeatable routine. Track your progress in cycles. Three modes.",
  "author": "sparkinCreations",
  "homepage_url": "https://minicycleapp.com",

  "action": {
    "default_title": "miniCycle lite",
    "default_popup": "miniCycle-lite.html",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "32":  "icons/icon-32.png",
      "48":  "icons/icon-48.png",
      "128": "icons/minicycle_logo_icon.png"
    }
  },

  "icons": {
    "16":  "icons/icon-16.png",
    "32":  "icons/icon-32.png",
    "48":  "icons/icon-48.png",
    "128": "icons/minicycle_logo_icon.png",
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },

  "host_permissions": [
    "https://api.web3forms.com/*"
  ]
}
