\f2\b 8. Service Worker
\f1\b0 \
\
  \cf3 // service-worker.js\cf2 \
  \cf4 const\cf2  CACHE_VERSION = \cf6 'v416'\cf2 ;\
  \cf4 const\cf2  CACHE_NAME = \cf6 `miniCycle-$\{CACHE_VERSION\}`\cf2 ;\
\
  \cf4 const\cf2  ASSETS_TO_CACHE = [\
    \cf6 '/'\cf2 ,\
    \cf6 '/index.html'\cf2 ,\
    \cf6 '/css/main.css'\cf2 ,\
    \cf6 '/js/app.js'\cf2 ,\
    \cf3 // ... all assets\cf2 \
  ];\
\
  self.addEventListener(\cf6 'install'\cf2 , \cf7 event =>\cf2  \{\
    event.waitUntil(\
      caches.open(CACHE_NAME)\
        .then(\cf7 cache =>\cf2  cache.addAll(ASSETS_TO_CACHE))\
        .then(\cf7 () =>\cf2  self.skipWaiting())\
    );\
  \});\
\
  self.addEventListener(\cf6 'activate'\cf2 , \cf7 event =>\cf2  \{\
    event.waitUntil(\
      caches.keys().then(\cf7 keys =>\cf2 \
        \cf5 Promise\cf2 .all(\
          keys.filter(\cf7 key =>\cf2  key !== CACHE_NAME)\
              .map(\cf7 key =>\cf2  caches.delete(key))\
