\f2\b 7. Storage Size Calculator
\f1\b0 \
\
  \cf3 // They show "~7 KB" - must calculate this\cf2 \
  \cf4 const\cf2  StorageCalc = \{\
\
    \cf7 getRoutineSize(routine)\cf2  \{\
