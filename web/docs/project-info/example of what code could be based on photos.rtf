      \cf4 return\cf2  \cf6 `~$\{(bytes / (\cf3 1024\cf6  * \cf3 1024\cf6 )).toFixed(\cf3 2\cf6 )\} MB`\cf2 ;\
    \},\
\
    \cf7 getTotalUsage()\cf2  \{\
      \cf4 let\cf2  total = \cf3 0\cf2 ;\
