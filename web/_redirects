# Domain redirect for minicycleapp.com (with forced redirect)
https://minicycleapp.com/*  https://minicycle.app/pages/product.html  301!
https://www.minicycleapp.com/*  https://minicycle.app/pages/product.html  301!

# Docs subdomain (own origin — Docsify's multi-MB localStorage search index
# must not share the app origin's ~5MB quota; see netlify.toml DOCS SUBDOMAIN
# block for the full story). Forced: must beat static files and the
# host-agnostic root/catch-all rules below for the docs host.
https://docs.minicycle.app/*  /docs/:splat  200!
https://minicycle.app/docs/*  https://docs.minicycle.app/:splat  301!

# Legacy URL redirects (preserve old links)
/privacy.html           /legal/privacy.html           301
/terms.html             /legal/terms.html             301
/user-manual.html       /legal/user-manual.html       301
/product.html           /pages/product.html           301
/learn_more.html        /pages/learn_more.html        301
/miniCycle-lite.html    /lite/miniCycle-lite.html     301
/miniCycleGames/*       /games/:splat                 301

# Redirect root to miniCycle.html
/    /miniCycle.html    200

# Handle 404s by serving miniCycle.html (SPA fallback)
/*   /miniCycle.html    404
