# Dependencies (anywhere in repo)
**/node_modules/
node_modules/

# Test artifacts
tests/automated/*.log
tests/automated/screenshots/

# Coverage reports
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db

# macOS file duplicates (created when opening .mcyc files)
*\ 2.mcyc
*\ 3.mcyc

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Temporary files
.tmp/
temp/

# Backup folders
backup/

# Ignore subdirectories in docs/archive (keep files only)
docs/archive/*/
dist/

# Lighthouse CI run artifacts (lhci autorun writes these locally; the release
# script stages with `git add -A`, so without this they ride into release commits
# — 106k lines landed in v2.376 that way).
.lighthouseci/
