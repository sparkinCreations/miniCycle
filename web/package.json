{
  "name": "minicycle-web",
  "version": "2.424",
  "description": "miniCycle - Turn Your Routine Into Progress",
  "type": "module",
  "private": true,
  "//": "=== TESTING NOTES ===",
  "// Jest removed": "Jest was removed in favor of comprehensive Playwright browser tests (958 tests, 100% coverage). Browser tests are more appropriate for this project since all modules use browser APIs (DOM, localStorage, etc.). Jest tests were experimental, broken, and added no value over the existing browser test suite.",
  "scripts": {
    "start": "python3 scripts/serve.py",
    "start:simple": "python3 -m http.server 8080",
    "start:test-origin": "python3 scripts/serve.py 8081",
    "blog:install": "cd blog && npm install",
    "blog:build": "cd blog && npm run build",
    "test": "node tests/automated/run-browser-tests.cjs",
    "test:browser": "node tests/automated/run-browser-tests.cjs",
    "test:layout": "node tests/automated/run-layout-overlap-tests.cjs",
    "test:sw": "node tests/automated/run-sw-offline-tests.cjs",
    "test:meta": "node tests/automated/run-meta-tests.cjs",
    "test:journey": "node tests/automated/run-journey-tests.cjs",
    "test:manual": "python3 -m http.server 8080",
    "perf": "node tests/automated/run-performance-benchmarks.cjs",
    "lint": "eslint modules/ service-worker.js miniCycle-main.js boot-sw.js --max-warnings=360",
    "lint:fix": "eslint modules/ --fix",
    "validate:di": "node scripts/validate-di-deps.js",
    "validate:legacy": "node scripts/validate-legacy-reads.js",
    "validate:comments": "node scripts/validate-comment-refs.js",
    "validate:builtins": "node scripts/validate-es-builtins.js",
    "validate:labels": "node scripts/validate-labels.js",
    "sweep:cruft": "node scripts/sweep-icloud-cruft.cjs",
    "validate:inline": "python3 scripts/validate-inline.py",
    "validate:csp": "python3 scripts/validate-csp.py",
    "check:dupes": "bash scripts/check-duplicates.sh",
    "clean:dupes": "bash scripts/check-duplicates.sh --fix",
    "validate:docs": "python3 scripts/validate-docs.py",
    "validate:html": "python3 scripts/validate-html.py",
    "validate:html:dist": "python3 scripts/validate-html.py --dist",
    "samples": "./scripts/generate-sample-manifest.sh",
    "build:chrome-full": "node scripts/build-chrome-full.cjs",
    "build:android": "node scripts/build-android-www.cjs",
    "build:ios": "node scripts/build-ios-www.cjs",
    "capture:screenshots": "node scripts/capture-store-screenshots.cjs",
    "lighthouse": "lhci autorun",
    "lighthouse:install": "npm install -g @lhci/cli",
    "build:web": "node scripts/build-web.cjs",
    "preview:dist": "cd dist && python3 -m http.server 8081"
  },
  "keywords": [
    "productivity",
    "routine",
    "cycle",
    "tasks"
  ],
  "author": "miniCycle",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "eslint": "^9.39.2",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "playwright": "^1.56.0"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.4"
  }
}
